    { "id": "positive-choice-26", "text": "一つだけ保証されるなら、失敗からすぐ立ち直る力より、挑戦する勇気を選びたい。", "yesLabel": "挑戦する勇気", "noLabel": "立ち直る力", "theme": "challenge" },
    { "id": "positive-choice-27", "text": "予定のない週末にもらうなら、どこへ行っても混雑しないことより、完璧な晴天を選びたい。", "yesLabel": "完璧な晴天", "noLabel": "混雑しないこと", "theme": "daily" },

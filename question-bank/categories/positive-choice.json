    { "id": "positive-choice-41", "text": "親密な相手との間で一つだけ分かるなら、自分の思いがすべて伝わることより、相手の本心がすべて分かることを選びたい。", "yesLabel": "相手の本心が分かる", "noLabel": "自分の思いが伝わる", "theme": "relationships", "sensitivityLevel": 2, "sensitiveTopics": ["romance", "privacy"], "requiresOptIn": true, "inspiration": "sukidayo-ultimate-questions" },

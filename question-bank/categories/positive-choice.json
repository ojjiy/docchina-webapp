  "description": "魅力的な二案から、本人がより選びたい側を言い切る自己記述文",
  "questions": [
    { "id": "positive-choice-01", "text": "一年間無料になるなら、外食代より旅行の交通費を選びたい。", "yesLabel": "旅行の交通費", "noLabel": "外食代", "theme": "travel" },
    { "id": "positive-choice-02", "text": "毎週増えるなら、自由に使える一万円より自由な休日一日を選びたい。", "yesLabel": "自由な休日一日", "noLabel": "自由に使える一万円", "theme": "values" },
    { "id": "positive-choice-03", "text": "身につくなら、どんな楽器も演奏できる力より、どんな料理もおいしく作れる力を選びたい。", "yesLabel": "料理の力", "noLabel": "楽器の力", "theme": "hobby" },
    { "id": "positive-choice-04", "text": "家に一つ追加できるなら、高性能なホームシアターより大きな本棚を選びたい。", "yesLabel": "大きな本棚", "noLabel": "ホームシアター", "theme": "entertainment" },
    { "id": "positive-choice-05", "text": "毎朝届くなら、季節の果物より焼きたてのパンを選びたい。", "yesLabel": "焼きたてのパン", "noLabel": "季節の果物", "theme": "food" },
    { "id": "positive-choice-06", "text": "旅の特典としてもらうなら、乗り放題の交通券より、どこでも使える宿泊券を選びたい。", "yesLabel": "宿泊券", "noLabel": "交通券", "theme": "travel" },
    { "id": "positive-choice-07", "text": "一日だけ達人になれるなら、絵を描くことより写真撮影を選びたい。", "yesLabel": "写真撮影", "noLabel": "絵を描くこと", "theme": "hobby" },
    { "id": "positive-choice-08", "text": "理想の休日をもらえるなら、好きな人たちが全員集まる一日より、誰にも邪魔されない一日を選びたい。", "yesLabel": "一人で過ごす一日", "noLabel": "みんなで過ごす一日", "theme": "relationships" },
    { "id": "positive-choice-09", "text": "仕事や勉強で得られるなら、記憶力が二倍になる力より、集中力が二倍になる力を選びたい。", "yesLabel": "集中力", "noLabel": "記憶力", "theme": "work-study" },
    { "id": "positive-choice-10", "text": "自宅の環境を理想にできるなら、外の音がまったく入らない静けさより、いつも快適な室温を選びたい。", "yesLabel": "快適な室温", "noLabel": "完全な静けさ", "theme": "senses" },
    { "id": "positive-choice-11", "text": "一年間楽しめるなら、ライブ・舞台への月一回招待より、映画館の通い放題を選びたい。", "yesLabel": "映画館通い放題", "noLabel": "ライブ・舞台招待", "theme": "entertainment" },
    { "id": "positive-choice-12", "text": "一瞬で得られるなら、プログラミング言語を一つ使いこなす力より、外国語を一つ話せる力を選びたい。", "yesLabel": "外国語", "noLabel": "プログラミング言語", "theme": "work-study" },
    { "id": "positive-choice-13", "text": "身体能力が上がるなら、どんな運動にも対応できるバランス感覚より、長時間疲れない体力を選びたい。", "yesLabel": "疲れない体力", "noLabel": "バランス感覚", "theme": "sports-health" },
    { "id": "positive-choice-14", "text": "買い物の特典なら、買った物が必ず長持ちすることより、すべての商品が二割引になることを選びたい。", "yesLabel": "すべて二割引", "noLabel": "必ず長持ち", "theme": "money" },
    { "id": "positive-choice-15", "text": "毎日一時間増やせるなら、夜の自由時間より朝の自由時間を選びたい。", "yesLabel": "朝の自由時間", "noLabel": "夜の自由時間", "theme": "daily" },
    { "id": "positive-choice-16", "text": "未来の自分から届くなら、十年後の自分の一日を映した動画より、十年後の自分からの手紙を選びたい。", "yesLabel": "未来からの手紙", "noLabel": "未来の一日の動画", "theme": "future" },
    { "id": "positive-choice-17", "text": "デジタル機器の機能として欲しいなら、どこでも高速に通信できることより、充電が一か月持つことを選びたい。", "yesLabel": "一か月持つ充電", "noLabel": "どこでも高速通信", "theme": "digital" },
    { "id": "positive-choice-18", "text": "自宅の近くにできるなら、充実した図書館より大きな公園を選びたい。", "yesLabel": "大きな公園", "noLabel": "充実した図書館", "theme": "community" },
    { "id": "positive-choice-19", "text": "いつでも最良の状態になるなら、食事の栄養バランスより睡眠の質を選びたい。", "yesLabel": "睡眠の質", "noLabel": "食事の栄養", "theme": "sports-health" },
    { "id": "positive-choice-20", "text": "好きな作品の世界を楽しめるなら、舞台となった場所で一週間暮らすことより、登場人物と一日過ごすことを選びたい。", "yesLabel": "登場人物と過ごす", "noLabel": "作品世界で暮らす", "theme": "entertainment" },
    { "id": "positive-choice-21", "text": "子どもの頃の一日をもう一度楽しめるなら、家族で出かけた日より学校行事の日を選びたい。", "yesLabel": "学校行事の日", "noLabel": "家族で出かけた日", "theme": "childhood" },
    { "id": "positive-choice-22", "text": "一年間住めるなら、森に囲まれた家より海が見える家を選びたい。", "yesLabel": "海が見える家", "noLabel": "森に囲まれた家", "theme": "future" },
    { "id": "positive-choice-23", "text": "特別な食事を楽しむなら、好きな料理だけを集めた食べ放題より、一流店のコース料理を選びたい。", "yesLabel": "一流店のコース", "noLabel": "好きな料理の食べ放題", "theme": "food" },
    { "id": "positive-choice-24", "text": "褒められるなら、気配りの細やかさより発想の面白さを褒められる方が嬉しい。", "yesLabel": "発想の面白さ", "noLabel": "気配りの細やかさ", "theme": "relationships" },

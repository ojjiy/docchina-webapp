    { "id": "positive-choice-35", "text": "働く条件がよくなるなら、毎月の収入が増えるより、毎週の休日が一日増える方が嬉しい。", "yesLabel": "休日が一日増える", "noLabel": "毎月の収入が増える", "theme": "work-study", "inspiration": "mynavi-240213-2" },
    { "id": "positive-choice-36", "text": "毎日の特典なら、昼食代が無料になるより、通勤時間が半分になる方が嬉しい。", "yesLabel": "通勤時間が半分", "noLabel": "昼食代が無料", "theme": "work-study", "inspiration": "mynavi-240213-2" },
    { "id": "positive-choice-37", "text": "タケコプターより、どこでもドアが欲しい。", "yesLabel": "どこでもドア", "noLabel": "タケコプター", "theme": "entertainment", "namedEntities": ["どこでもドア", "タケコプター"], "inspiration": "mynavi-240213-2" },
